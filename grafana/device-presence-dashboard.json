      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Online Devices Over Time",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "postgres",
                      "version": "v0",
                      "datasource": {
                        "name": "${DS_POSTGRESQL}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "WITH filtered_devices AS (\n  SELECT d.id\n  FROM devices d\n  WHERE d.id::text IN (${devices:sqlstring})\n), initial AS (\n  SELECT COUNT(*)::integer AS online_count\n  FROM filtered_devices fd\n  LEFT JOIN LATERAL (\n    SELECT pe.event_type\n    FROM presence_events pe\n    WHERE pe.device_id = fd.id\n      AND pe.happened_at <= $__timeFrom()\n    ORDER BY pe.happened_at DESC, pe.id DESC\n    LIMIT 1\n  ) last_event ON TRUE\n  WHERE last_event.event_type = 'online'\n), changes AS (\n  SELECT\n    e.happened_at AS time,\n    SUM(CASE WHEN e.event_type = 'online' THEN 1 ELSE -1 END)::integer AS delta\n  FROM presence_events e\n  JOIN filtered_devices fd ON fd.id = e.device_id\n  WHERE $__timeFilter(e.happened_at)\n  GROUP BY e.happened_at\n), points AS (\n  SELECT $__timeFrom()::timestamptz AS time, 0::integer AS delta\n  UNION ALL\n  SELECT time, delta FROM changes\n)\nSELECT\n  time AS \"time\",\n  (SELECT online_count FROM initial)\n    + SUM(delta) OVER (ORDER BY time ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS \"Online devices\"\nFROM points\nORDER BY time;",
                        "sql": {
                          "columns": [],
                          "groupBy": [],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
