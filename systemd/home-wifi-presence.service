[Unit]
Description=Home Wi-Fi Presence Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/pi/device-monitoring
EnvironmentFile=/home/pi/device-monitoring/.env
ExecStart=/home/pi/device-monitoring/.venv/bin/uvicorn app.main:app --host ${APP_HOST} --port ${APP_PORT}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
