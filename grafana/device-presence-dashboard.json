      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Current Devices",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "postgres",
                      "version": "v0",
                      "datasource": {
                        "name": "${DS_POSTGRESQL}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  COALESCE(NULLIF(d.label, ''), NULLIF(d.hostname, ''), NULLIF(d.vendor, ''), d.mac) AS device,\n  CASE WHEN d.online THEN 'online' ELSE 'offline' END AS status,\n  COALESCE(latest_event.happened_at, d.first_seen) AS status_since,\n  d.ip,\n  d.mac,\n  d.vendor,\n  d.last_seen,\n  d.missed_scans\nFROM devices d\nLEFT JOIN LATERAL (\n  SELECT pe.happened_at\n  FROM presence_events pe\n  WHERE pe.device_id = d.id\n  ORDER BY pe.happened_at DESC, pe.id DESC\n  LIMIT 1\n) latest_event ON TRUE\nWHERE d.id::text IN (${devices:sqlstring})\nORDER BY d.online DESC, LOWER(COALESCE(NULLIF(d.label, ''), NULLIF(d.hostname, ''), NULLIF(d.vendor, ''), d.mac));",
