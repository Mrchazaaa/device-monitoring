                        "rawSql": "SELECT\n  e.happened_at AS time,\n  COALESCE(NULLIF(d.label, ''), NULLIF(d.hostname, ''), NULLIF(d.vendor, ''), d.mac) AS device,\n  e.event_type AS state,\n  d.ip,\n  d.mac\nFROM presence_events e\nJOIN devices d ON d.id = e.device_id\nWHERE $__timeFilter(e.happened_at)\n  AND d.id::text IN (${devices:sqlstring})\nORDER BY e.happened_at DESC, e.id DESC\nLIMIT 100;",
