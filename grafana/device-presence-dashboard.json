      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Device Presence Timeline",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "postgres",
                      "version": "v0",
                      "datasource": {
                        "name": "${DS_POSTGRESQL}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "WITH named_devices AS (\n  SELECT\n    d.id,\n    COALESCE(NULLIF(d.label, ''), NULLIF(d.hostname, ''), NULLIF(d.vendor, ''), d.mac) AS device_name,\n    d.online AS current_online\n  FROM devices d\n  WHERE d.id::text IN (${devices:sqlstring})\n), start_state AS (\n  SELECT\n    $__timeFrom()::timestamptz AS time,\n    nd.device_name AS metric,\n    CASE\n      WHEN last_event.event_type = 'online' THEN 1\n      WHEN last_event.event_type = 'offline' THEN 0\n      WHEN nd.current_online THEN 1\n      ELSE 0\n    END AS value\n  FROM named_devices nd\n  LEFT JOIN LATERAL (\n    SELECT pe.event_type\n    FROM presence_events pe\n    WHERE pe.device_id = nd.id\n      AND pe.happened_at <= $__timeFrom()\n    ORDER BY pe.happened_at DESC, pe.id DESC\n    LIMIT 1\n  ) last_event ON TRUE\n), range_events AS (\n  SELECT DISTINCT ON (e.device_id, e.happened_at)\n    e.happened_at AS time,\n    nd.device_name AS metric,\n    CASE WHEN e.event_type = 'online' THEN 1 ELSE 0 END AS value\n  FROM presence_events e\n  JOIN named_devices nd ON nd.id = e.device_id\n  WHERE $__timeFilter(e.happened_at)\n  ORDER BY e.device_id, e.happened_at, e.id DESC\n), end_state AS (\n  SELECT\n    $__timeTo()::timestamptz AS time,\n    nd.device_name AS metric,\n    CASE\n      WHEN last_event.event_type = 'online' THEN 1\n      WHEN last_event.event_type = 'offline' THEN 0\n      WHEN nd.current_online THEN 1\n      ELSE 0\n    END AS value\n  FROM named_devices nd\n  LEFT JOIN LATERAL (\n    SELECT pe.event_type\n    FROM presence_events pe\n    WHERE pe.device_id = nd.id\n      AND pe.happened_at <= $__timeTo()\n    ORDER BY pe.happened_at DESC, pe.id DESC\n    LIMIT 1\n  ) last_event ON TRUE\n)\nSELECT time AS \"time\", metric, value\nFROM start_state\nUNION ALL\nSELECT time AS \"time\", metric, value\nFROM range_events\nUNION ALL\nSELECT time AS \"time\", metric, value\nFROM end_state\nORDER BY 1, 2;",
                        "sql": {
                          "columns": [],
                          "groupBy": [],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
